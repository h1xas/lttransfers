---
import '../styles/global.css';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { assertLaunchReady } from '../data/launch';
import { languages, langs, type Lang } from '../data/ui';
import { getUi, localePath, stripLocale } from '../utils/i18n';
import sans400 from '../assets/fonts/instrument-sans-latin-400-normal.woff2?url';
import sans500 from '../assets/fonts/instrument-sans-latin-500-normal.woff2?url';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Force noindex. Languages that are not `ready` are always noindex. */
  noindex?: boolean;
  /** When the "Request a price" header button shows. 'off' on the request page itself. */
  headerCta?: 'after-hero' | 'always' | 'off';
}

assertLaunchReady();

const { lang, title, description, noindex = false, headerCta = 'always' } = Astro.props;
const t = getUi(lang);

const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site).href;

// hreflang only for languages that are published
const basePath = stripLocale(pathname);
const alternates = langs
  .filter((l) => languages[l].ready)
  .map((l) => ({ lang: languages[l].htmlLang, href: new URL(localePath(l, basePath), Astro.site).href }));

const robots = noindex || !languages[lang].ready ? 'noindex, nofollow' : 'index, follow';
const ogLocale = languages[lang].ogLocale;
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#F1EFEA" />
    <link rel="canonical" href={canonical} />
    {
      alternates.length > 1 && (
        <>
          {alternates.map((a) => (
            <link rel="alternate" hreflang={a.lang} href={a.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {langs.filter((l) => l !== lang && languages[l].ready).map((l) => <meta property="og:locale:alternate" content={languages[l].ogLocale} />)}
    <!-- TODO: og:image once a final share image exists (1200×630, no text on photo). -->

    <slot name="head" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={sans400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sans500} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <Header lang={lang} cta={headerCta} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
