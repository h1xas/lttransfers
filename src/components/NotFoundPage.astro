---
/*
  Missing-page screen, shared by /404 (en) and /lt/404 (lt). Same plain typography as the legal pages: a 2px
  rule, the H1, one line of text and two actions. Never indexed, no canonical or hreflang (BaseLayout `noindex`).
*/
import ArrowIcon from './ArrowIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../data/ui';
import { getUi, localePath } from '../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const n = getUi(lang).notFound;
---

<BaseLayout lang={lang} title={n.title} description={n.text} noindex headerCta="off">
  <section class="missing" aria-labelledby="nf-title">
    <div class="page-grid">
      <div class="rule" aria-hidden="true"></div>
      <h1 id="nf-title">{n.heading}</h1>
      <p class="text">{n.text}</p>
      <div class="actions">
        <a class="button" href={localePath(lang, '/request/')}>
          <span>{n.request}</span>
          <ArrowIcon class="button-arrow" width={22} />
        </a>
        <a class="home" href={localePath(lang, '/')}>{n.home}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .missing {
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
    /* Keeps the footer near the bottom of the window on tall screens. */
    min-height: 48vh;
  }
  .rule {
    grid-column: 1 / -1;
    height: 2px;
    background: var(--graphite);
  }
  h1 {
    grid-column: 1 / -1;
    margin-top: var(--space-4);
    font-size: clamp(2.25rem, 9.6vw, 2.5rem);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    text-wrap: balance;
  }
  .text {
    grid-column: 1 / -1;
    max-width: 30rem;
    margin-top: var(--space-2);
    font-size: var(--fs-body-l);
    line-height: 1.4;
    text-wrap: pretty;
  }
  .actions {
    grid-column: 1 / -1;
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-2);
  }
  .button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 56px;
    padding: 0 var(--object-inset);
    background: var(--graphite);
    color: var(--bone);
    border-radius: var(--radius-ctl);
    font-size: 0.8125rem;
    font-weight: var(--weight-medium);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease);
  }
  .button:hover {
    background: var(--graphite-hover);
  }
  .button:active {
    background: var(--graphite-press);
  }
  .button :global(.button-arrow) {
    flex: none;
    transition: transform var(--dur-fast) var(--ease);
  }
  .button:hover :global(.button-arrow) {
    transform: translateX(4px);
  }
  .home {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: var(--weight-medium);
  }

  @media (min-width: 768px) {
    .missing {
      padding-top: var(--space-5);
    }
    .actions {
      flex-direction: row;
      align-items: center;
      gap: var(--space-3);
    }
    .button {
      min-width: 17rem;
    }
  }
</style>
