---
/*
  FAQ contact block: "Still unsure? Ask us directly." + Phone and WhatsApp as hairline rows.
  Same placeholder handling as the certainty section: with no real number in data/site.ts
  the row prints its placeholder text and is NOT a link (nothing points at an invented number).

  Rendered twice by Faq.astro (beside the heading on desktop, after the questions below that);
  CSS shows exactly one copy, so the hidden one leaves no duplicate links in the tab order or the
  accessibility tree.
*/
import ArrowIcon from './ArrowIcon.astro';
import { site } from '../data/site';
import type { Lang } from '../data/ui';
import { getUi } from '../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);

const rows = [
  {
    key: 'phone',
    label: t.contact.phone,
    value: site.contact.phone.display,
    href: site.contact.phone.tel ? `tel:${site.contact.phone.tel}` : null,
    external: false,
  },
  {
    key: 'whatsapp',
    label: t.contact.whatsapp,
    value: t.certainty.whatsappValue,
    href: site.contact.whatsapp.url,
    external: true,
  },
];
---

<div class="contact">
  <p class="support">{t.faq.support}</p>
  <ul role="list" class="rows" aria-label={t.faq.contactLabel}>
    {
      rows.map((row) => {
        const Tag = row.href ? 'a' : 'div';
        return (
          <li>
            <Tag
              class:list={['row', { 'is-placeholder': !row.href }]}
              href={row.href ?? undefined}
              target={row.href && row.external ? '_blank' : undefined}
              rel={row.href && row.external ? 'noopener' : undefined}
              data-placeholder={row.href ? undefined : ''}
            >
              <span class="row-label">{row.label}</span>
              <span class="row-value">{row.value}</span>
              {row.href && <ArrowIcon class="go" width={22} />}
            </Tag>
          </li>
        );
      })
    }
  </ul>
</div>

<style>
  .support {
    font-size: var(--fs-body-l);
    font-weight: var(--weight-medium);
    line-height: 1.35;
    letter-spacing: -0.005em;
    text-wrap: balance;
  }

  .rows {
    margin-top: var(--space-2);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .rows li + li {
    border-top: 1px solid var(--hairline);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-2);
    align-items: center;
    min-height: 68px;
    padding-block: 12px;
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--dur-fast) var(--ease);
  }
  .row-label {
    grid-column: 1;
    color: var(--graphite-2);
    font-size: var(--fs-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    line-height: 1.2;
  }
  .row-value {
    grid-column: 1;
    margin-top: 4px;
    font-size: var(--fs-body-l);
    font-weight: var(--weight-medium);
    line-height: 1.3;
  }
  .row :global(.go) {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--pine);
  }
  .row.is-placeholder .row-value {
    color: var(--graphite-2);
    font-weight: var(--weight-regular);
  }
  a.row:focus-visible {
    outline-offset: -2px;
  }
  a.row:active {
    background: color-mix(in srgb, var(--graphite) 6%, transparent);
  }
  @media (hover: hover) {
    a.row:hover {
      background: color-mix(in srgb, var(--graphite) 5%, transparent);
    }
  }
</style>
