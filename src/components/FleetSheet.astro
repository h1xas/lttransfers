---
/*
  The cars: "the fleet sheet". Five photographs, one controlled set.

  Every photograph is prepared to the same frame (same angle, direction, light, scale),
  so all five share one image treatment: one aspect ratio, `object-fit: cover` and one
  `object-position`. Nothing is stretched, and nothing is positioned per vehicle.
  The crop is horizontal only (16:9 source into 16:10), inside the empty margin the
  frame leaves on both sides of every car, so no wheel, mirror or bumper is cut.

  Desktop (≥1200px): three vehicles across, two centred beneath them, the footnote centred below
  those. Each vehicle is one cell of a wrapping flex row: all photographs are exactly one width, and
  cells in a row are as tall as the tallest.
  768–1199px: a list, one vehicle per row, photograph left, text right.
  Below 768px: one vehicle per row, photograph above its text (no arrow).
  No carousel.

  Each vehicle is one link into the request flow carrying a *preference*
  (`?vehicle=`). The homepage holds no selected state.
*/
import { Picture } from 'astro:assets';
import ArrowIcon from './ArrowIcon.astro';
import { fleet, recommendRequest } from '../data/fleet';
import type { Lang } from '../data/ui';
import { format, getUi } from '../utils/i18n';
import { requestVehicleHref } from '../utils/routes';
import rav4 from '../assets/fleet/toyota-rav4.png';
import cClass from '../assets/fleet/mercedes-benz-c-class.png';
import eClass from '../assets/fleet/mercedes-benz-e-class.png';
import a8 from '../assets/fleet/audi-a8.png';
import berlingo from '../assets/fleet/citroen-berlingo-multispace.png';

interface Props {
  lang: Lang;
}

/** Fleet `id` (data/fleet.ts) → its prepared photograph. */
const photos: Record<string, ImageMetadata> = {
  rav4,
  'c-class': cClass,
  'e-class': eClass,
  a8,
  berlingo,
};

const { lang } = Astro.props;
const t = getUi(lang);
const c = t.cars;
const vehicles = fleet.map((v) => {
  const name = `${v.brand} ${v.model}`;
  return {
    ...v,
    name,
    photo: photos[v.id],
    alt: format(c.imageAlt, { name }),
    href: requestVehicleHref(lang, v.request),
    ...c.vehicles[v.id],
  };
});
---

<section class="cars" id="cars" aria-labelledby="cars-title">
  <div class="page-grid">
    <div class="intro">
      <h2 id="cars-title">{c.title}</h2>
      <p class="lead">{c.lead}</p>
    </div>

    <div class="sheet">
      <ul class="list" role="list">
        {
          vehicles.map((v) => (
            <li class="vehicle">
              <a class="link" href={v.href} aria-label={format(c.chooseLabel, { name: v.name })}>
                <span class="art">
                  <Picture
                    src={v.photo}
                    alt={v.alt}
                    formats={['avif', 'webp']}
                    fallbackFormat="jpeg"
                    quality={72}
                    widths={[480, 640, 800, 1000, 1200]}
                    sizes="(min-width: 1200px) 30vw, (min-width: 768px) 440px, 100vw"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
                <span class="name">
                  {v.brand} <span class="model">{v.model}</span>
                </span>
                <span class="descriptor">{v.descriptor}</span>
                <span class="note">{v.note}</span>
                <ArrowIcon class="go" width={22} />
              </a>
            </li>
          ))
        }
      </ul>

      <p class="footnote">
        <span>{c.footnote.before}<a href={requestVehicleHref(lang, recommendRequest)}>{c.footnote.link}</a>{c.footnote.after}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .cars {
    background: var(--stone-2);
    color: var(--graphite);
    padding-block: clamp(72px, 8.8vw, 128px) clamp(72px, 8.3vw, 120px);
  }

  /* ---------- Intro ---------- */
  .intro {
    grid-column: 1 / -1;
    margin-bottom: var(--space-5);
  }
  h2 {
    font-size: var(--fs-display-l);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
  }
  .lead {
    max-width: 30rem;
    margin-top: var(--space-2);
    text-wrap: balance;
    color: var(--graphite-2);
    font-size: var(--fs-body-l);
    line-height: 1.45;
  }

  /* ---------- Sheet (stacked layout by default) ---------- */
  .sheet {
    grid-column: 1 / -1;
    container-type: inline-size; /* the tablet photograph is measured against this width */
    --art-w: min(48cqw, 440px);
    --gap: 20px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--hairline);
  }
  .vehicle {
    border-top: 1px solid var(--hairline);
  }

  /* Phone: photograph full width above its text. */
  .link {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: var(--gap);
    align-items: start;
    padding-block: 20px 24px;
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--dur-fast) var(--ease);
  }
  .link:focus-visible {
    outline-offset: -2px;
  }
  .link:active {
    background: color-mix(in srgb, var(--graphite) 6%, transparent);
  }

  /* The one image treatment, shared by all five vehicles. */
  .art {
    grid-column: 1 / -1;
    grid-row: 1;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--stone-2);
    transition: opacity var(--dur-fast) var(--ease);
  }
  .art :global(picture),
  .art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .art :global(img) {
    object-fit: cover;
    object-position: 42% 50%;
  }

  .name {
    grid-column: 1;
    grid-row: 2;
    margin-top: 16px;
    font-size: var(--fs-title);
    font-weight: var(--weight-medium);
    line-height: 1.2;
  }
  .model {
    display: block;
  }
  .descriptor {
    grid-column: 1;
    grid-row: 3;
    margin-top: 8px;
    color: var(--graphite-2);
    font-size: var(--fs-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    line-height: 1.25;
  }
  .note {
    grid-column: 1;
    grid-row: 4;
    margin-top: 6px;
    max-width: 22rem;
    color: var(--graphite-2);
    font-size: 0.9375rem;
    line-height: 1.4;
    text-wrap: pretty;
  }
  /* The arrow is for the tablet list only: on a phone the whole card is the link and needs no pointer. */
  .link :global(.go) {
    display: none;
    color: var(--pine);
  }

  /* ---------- Footnote ---------- */
  .footnote {
    grid-column: 1 / -1;
    margin-top: var(--space-3);
    color: var(--graphite-2);
    font-size: var(--fs-body);
    line-height: 1.5;
  }
  .footnote a {
    color: var(--graphite);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease);
  }
  .footnote a:hover {
    color: var(--pine);
  }

  @media (hover: hover) {
    .link:hover {
      background: color-mix(in srgb, var(--graphite) 5%, transparent);
    }
  }

  /* ---------- Tablet list: photograph left, text right ---------- */
  @media (min-width: 768px) {
    .intro {
      margin-bottom: var(--space-6);
    }
    h2 {
      font-size: clamp(2.25rem, 3.8vw, 3rem);
    }
    .sheet {
      --gap: var(--space-4);
    }
    .link {
      grid-template-columns: var(--art-w) minmax(0, 1fr) auto;
      grid-template-rows: 1fr auto auto auto 1fr;
      padding-block: 24px;
    }
    .art {
      grid-column: 1;
      grid-row: 1 / -1;
    }
    .name,
    .descriptor,
    .note {
      grid-column: 2;
    }
    .name {
      margin-top: 0;
    }
    .note {
      font-size: var(--fs-body);
    }
    .link :global(.go) {
      display: block;
      grid-column: 3;
      grid-row: 1 / -1;
      align-self: center;
    }
  }
  /* A wide row or column has the room for "Mercedes-Benz E-Class" on one line; the phone row does not. */
  @media (min-width: 768px) {
    .model {
      display: inline;
    }
  }

  /* ---------- Desktop sheet: three across, two centred beneath, one controlled set ---------- */
  @media (min-width: 1200px) {
    .sheet {
      --pad: clamp(20px, 2.2vw, 36px);
      /* Every photograph is exactly --photo wide. The first column is flush with the heading (one padding
         less), so its cell is one padding narrower; the cells after it carry a 1px divider. */
      --photo: calc((100% - 5 * var(--pad) - 2px) / 3);
    }
    .list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      border-top: 1px solid var(--hairline);
    }
    /* The full-width hairline between the two rows, and the line break that makes the second row. */
    .list::before {
      content: '';
      order: 1;
      flex: 0 0 100%;
      height: 0;
      border-top: 1px solid var(--hairline);
    }
    .vehicle {
      order: 0;
      flex: 0 0 calc(var(--photo) + 2 * var(--pad));
      border-top: 0;
      --pl: var(--pad);
    }
    .vehicle:first-child {
      flex-basis: calc(var(--photo) + var(--pad));
      --pl: 0px; /* flush with the heading */
    }
    .vehicle:nth-child(n + 4) {
      order: 2;
    }
    .vehicle:is(:nth-child(2), :nth-child(3), :nth-child(5)) {
      flex-basis: calc(var(--photo) + 2 * var(--pad) + 1px);
      border-left: 1px solid var(--hairline);
    }

    .link {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      height: 100%;
      align-content: start;
      align-items: start;
      padding: 32px var(--pad) 32px var(--pl);
    }
    .link:focus-visible {
      outline-offset: -3px;
    }
    /* The first column's text is flush with the heading (no left padding): its ring sits outside the text, not across it. */
    .vehicle:first-child .link:focus-visible {
      outline-offset: 6px;
    }
    .link:active {
      background: none;
    }

    .art,
    .name,
    .descriptor,
    .note {
      grid-column: 1;
    }
    .art {
      grid-row: 1;
    }
    .name {
      grid-row: 2;
      margin-top: 24px;
      font-size: clamp(1.375rem, 1.9vw, 1.75rem);
    }
    .descriptor {
      grid-row: 3;
      margin-top: 12px;
    }
    .note {
      grid-row: 4;
      margin-top: 12px;
      font-size: var(--fs-body-l);
    }
    .link :global(.go) {
      display: none;
    }

    /* Hover / focus: the active photograph stays full strength, the others recede. */
    .sheet:has(.link:is(:hover, :focus-visible)) .link:not(:hover, :focus-visible) .art {
      opacity: 0.55;
    }
    .link:hover,
    .link:active {
      background: none;
    }

    /* Beneath the two centred cars, centred on the page. */
    .footnote {
      margin: 0;
      padding-block: var(--space-4) 0;
      text-align: center;
    }
  }
</style>
