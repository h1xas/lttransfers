---
/*
  Made for journeys that need certainty: "the transport document".

  Service facts set the way a ticket prints its conditions of carriage. Back to
  stone after the fleet's stone-2. Typography and rules only: no cards, icons,
  badges, photography or animation.

  One continuous document column, three ruled blocks (2px graphite rules between):
    1. three display facts in one row (24/7 · Agreed price · 4 countries), separated by
       vertical hairlines, no box around any of them;
    2. two full-width rows (Payment options, Invoices);
    3. the operator register, then the contact rows.
  Label / value rows in 2 and 3 use the facts' own column track, so every value
  starts on the second hairline.

  Desktop (≥1100px): heading + lead on c1–4, the document on c5–12. Not sticky: the
  document is shorter than a viewport, so sticky would add nothing.
  Tablet (768–1099px): heading above, the same document across the full width.
  Phone: facts stack as rows (figure left, description right); every row is full width.

  Only confirmed information is rendered. Register rows and the email row exist
  only when `data/site.ts` holds a value; nothing prints a blank or "TBC". There is no
  VAT field (the operator is not VAT-registered), no reviews and no personal content.
*/
import ArrowIcon from './ArrowIcon.astro';
import { site } from '../data/site';
import type { Lang } from '../data/ui';
import { getUi } from '../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
const c = t.certainty;
const reg = c.register;

// Register: the operator is confirmed and always printed; the other rows appear only when a value is supplied.
// (The service name is not repeated here: the whole page already says LT Transfers.)
const extras = [
  { key: 'legalForm', label: reg.legalForm, value: site.register.legalForm },
  { key: 'companyCode', label: reg.companyCode, value: site.register.companyCode },
  { key: 'address', label: reg.address, value: site.register.address },
  { key: 'permit', label: reg.permit, value: site.register.permit },
  { key: 'insurance', label: reg.insurance, value: site.register.insurance },
].filter((row): row is { key: string; label: string; value: string } => Boolean(row.value));

// Contact: phone and WhatsApp follow the build's existing placeholder handling (see ContactLink):
// no working link until real details exist. Email only once confirmed.
const contacts = [
  {
    key: 'phone',
    label: t.contact.phone,
    value: site.contact.phone.display,
    href: site.contact.phone.tel ? `tel:${site.contact.phone.tel}` : null,
    external: false,
  },
  {
    key: 'whatsapp',
    label: t.contact.whatsapp,
    value: c.whatsappValue,
    href: site.contact.whatsapp.url,
    external: true,
  },
  ...(site.contact.email
    ? [{ key: 'email', label: c.email, value: site.contact.email, href: `mailto:${site.contact.email}`, external: false }]
    : []),
];
---

<section class="certainty" aria-labelledby="certainty-title">
  <div class="page-grid">
    <div class="head-rule" aria-hidden="true"></div>

    <div class="intro">
      <h2 id="certainty-title">{c.title}</h2>
      <p class="lead">{c.lead}</p>
    </div>

    <div class="doc">
      <ul class="facts" role="list">
        <li class="fact">
          <p class="figure">{c.facts.hours.figure}</p>
          <p class="text">{c.facts.hours.text}</p>
        </li>
        <li class="fact">
          <p class="figure words">{c.facts.price.figure}</p>
          <p class="text">{c.facts.price.text}</p>
        </li>
        <li class="fact">
          <p class="figure">
            {c.facts.countries.figure}<span class="unit">{c.facts.countries.unit}</span>
          </p>
          <p class="text">
            {c.facts.countries.places.map((place, i, all) => (
              <>
                <span class="place">{place}{i < all.length - 1 ? ',' : ''}</span>{i < all.length - 1 ? ' ' : ''}
              </>
            ))}
          </p>
        </li>
      </ul>

      <dl class="terms">
        <div class="row">
          <dt>{c.payment.label}</dt>
          <dd>{c.payment.value}</dd>
        </div>
        <div class="row">
          <dt>{c.invoices.label}</dt>
          <dd>{c.invoices.value}</dd>
        </div>
      </dl>

      <div class="operator">
        <dl class="register">
          <div class="row row-operator">
            <dt>{reg.operator}</dt>
            <dd>{site.operator}</dd>
          </div>
          {
            extras.map((row) => (
              <div class="row row-extra" data-field={row.key}>
                <dt>{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))
          }
        </dl>

        <ul class="contact" role="list" aria-label={c.contactLabel}>
          {
            contacts.map((row) => {
              const Tag = row.href ? 'a' : 'div';
              return (
                <li>
                  <Tag
                    class:list={['row', 'contact-row', { 'is-placeholder': !row.href }]}
                    href={row.href ?? undefined}
                    target={row.href && row.external ? '_blank' : undefined}
                    rel={row.href && row.external ? 'noopener' : undefined}
                    data-placeholder={row.href ? undefined : ''}
                  >
                    <span class="label-text">{row.label}</span>
                    <span class="value">{row.value}</span>
                    {row.href && <ArrowIcon class="go" width={22} />}
                  </Tag>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .certainty {
    background: var(--stone);
    color: var(--graphite);
    padding-block: clamp(72px, 7.8vw, 112px);
    /* Column track shared by the facts row and every label / value row below it. */
    --cols: minmax(0, 1fr) minmax(0, 1.1fr) minmax(0, 1.1fr);
    --cell-pad: clamp(16px, 2vw, 28px);
    --rule: 2px solid var(--graphite);
    /* Air between the three layers: facts, conditions, operator. */
    --layer-gap: 40px;
  }

  .head-rule {
    display: none;
  }

  /* ---------- Intro ---------- */
  .intro {
    grid-column: 1 / -1;
    margin-bottom: var(--space-5);
  }
  h2 {
    font-size: var(--fs-display-l);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
  }
  .lead {
    max-width: 30rem;
    margin-top: var(--space-2);
    text-wrap: balance;
    color: var(--graphite-2);
    font-size: var(--fs-body-l);
    line-height: 1.45;
  }

  .doc {
    grid-column: 1 / -1;
  }

  /* ---------- Layer 1 · display facts (phone: three stacked rows, figure over description) ---------- */
  .facts {
    list-style: none;
    padding: 0;
    border-top: var(--rule);
  }
  .fact {
    padding-block: 28px 30px;
    border-top: 1px solid var(--hairline);
  }
  .fact:first-child {
    padding-top: 32px;
    border-top: 0;
  }
  /* the layer gap below carries the air here */
  .fact:last-child {
    padding-bottom: 4px;
  }
  .figure {
    font-size: var(--fs-figure-xl);
    font-weight: var(--weight-medium);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* "Agreed price" is words, not a number: set one step below the figures so it belongs to the same family
     without out-shouting them (45px against 56px on a phone). */
  .figure.words {
    font-size: 2.8125rem;
  }
  .unit {
    margin-left: 0.28em;
    color: var(--graphite-2);
    font-size: var(--fs-title);
    letter-spacing: 0;
    font-weight: var(--weight-medium);
  }
  .text {
    margin-top: 10px;
    color: var(--graphite-2);
    font-size: var(--fs-body);
    line-height: 1.4;
    text-wrap: pretty;
  }
  .place {
    white-space: nowrap;
  }

  /* ---------- Label / value rows ---------- */
  .terms,
  .operator {
    margin-top: var(--layer-gap);
    border-top: var(--rule);
  }
  .row {
    display: block;
    padding-block: 18px;
    border-top: 1px solid var(--hairline);
  }
  .row:first-child {
    border-top: 0;
  }
  dt,
  .label-text {
    color: var(--graphite-2);
    font-size: var(--fs-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    line-height: 1.2;
  }
  dd {
    margin: 6px 0 0;
  }

  /* ---------- Layer 2 · conditions ---------- */
  .terms dd {
    font-size: var(--fs-body-l);
    line-height: 1.4;
  }

  /* ---------- Layer 3 · operator ---------- */
  /* The operator is the one named party on the page: stronger than register metadata, quieter than a headline. */
  .row-operator {
    padding-block: 24px 22px;
  }
  .row-operator dd {
    margin-top: 8px;
    font-size: var(--fs-title);
    font-weight: var(--weight-medium);
    line-height: 1.2;
    letter-spacing: 0.01em;
  }
  /* Further register rows (code, address, permit, insurance) print only when supplied, in small type. */
  .row-extra {
    padding-block: 12px;
  }
  .row-extra dd {
    margin-top: 4px;
    font-size: var(--fs-small);
    line-height: 1.45;
  }

  /* Contact: real rows, real tap targets, same row language. */
  .contact {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--hairline);
    border-bottom: var(--rule);
  }
  .contact li + li {
    border-top: 1px solid var(--hairline);
  }
  .contact-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-2);
    align-items: center;
    min-height: 76px;
    padding-block: 14px;
    border-top: 0;
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--dur-fast) var(--ease);
  }
  .contact-row .label-text {
    grid-column: 1;
  }
  .contact-row .value {
    grid-column: 1;
    margin-top: 5px;
    font-size: var(--fs-body-l);
    font-weight: var(--weight-medium);
    line-height: 1.3;
  }
  .contact-row :global(.go) {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--pine);
  }
  .contact-row.is-placeholder .value {
    color: var(--graphite-2);
    font-weight: var(--weight-regular);
  }
  a.contact-row:focus-visible {
    outline-offset: -2px;
  }
  a.contact-row:active {
    background: color-mix(in srgb, var(--graphite) 6%, transparent);
  }
  @media (hover: hover) {
    a.contact-row:hover {
      background: color-mix(in srgb, var(--graphite) 5%, transparent);
    }
  }

  /* ---------- Tablet and up: facts in one row, label / value rows on the facts' track ---------- */
  @media (min-width: 768px) {
    .certainty {
      --layer-gap: 48px;
    }
    /* the facts' own bottom padding is the air above the conditions */
    .terms {
      margin-top: 0;
    }
    .intro {
      margin-bottom: var(--space-6);
    }
    h2 {
      font-size: clamp(2.25rem, 3.8vw, 3rem);
    }

    .facts {
      display: grid;
      grid-template-columns: var(--cols);
    }
    .fact {
      /* two shared rows (figure, description) so the three baselines and descriptions line up */
      grid-row: span 2;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: subgrid;
      row-gap: 20px;
      align-items: start;
      padding: 40px var(--cell-pad) 44px;
      border-top: 0;
      border-left: 1px solid var(--hairline);
    }
    .fact:first-child {
      padding-top: 40px;
      padding-left: 0;
      border-left: 0;
    }
    .fact:last-child {
      padding-bottom: 44px;
    }
    .figure {
      align-self: end;
    }
    .figure.words {
      --wr: 0.6; /* words-to-figure size; 0.5 on desktop */
      font-size: calc(var(--fs-figure-xl) * var(--wr));
      line-height: 0.96;
      width: min-content;
      white-space: normal;
      /* seat the last line's baseline on the figures' baseline: the smaller the type, the lower it sits in its box */
      margin-bottom: calc(var(--fs-figure-xl) * (0.1635 - 0.128 * var(--wr)));
    }
    .unit {
      margin-left: 0.2em;
      font-size: clamp(1.125rem, 1.7vw, 1.5rem);
    }
    .text {
      margin-top: 0;
      font-size: var(--fs-body);
      text-wrap: balance;
    }

    .row {
      display: grid;
      grid-template-columns: var(--cols);
      align-items: center;
      align-content: center;
      min-height: 72px;
      padding-block: 0;
    }
    dt,
    .label-text {
      grid-column: 1;
    }
    dd,
    .contact-row .value {
      grid-column: 2 / -1;
      margin: 0;
      padding-left: var(--cell-pad);
    }
    .terms dd {
      font-size: var(--fs-body-l);
    }

    .row-operator {
      min-height: 104px;
      padding-block: 0;
    }
    .row-operator dd {
      margin: 0;
      padding-left: var(--cell-pad);
      font-size: clamp(1.375rem, 2vw, 1.75rem);
    }
    .row-extra {
      min-height: 44px;
      padding-block: 10px;
    }

    .contact-row {
      grid-template-columns: var(--cols);
      column-gap: 0;
      min-height: 68px;
      padding-block: 0;
    }
    .contact-row .label-text {
      grid-column: 1;
    }
    .contact-row .value {
      grid-row: 1;
    }
    .contact-row :global(.go) {
      grid-row: 1;
      grid-column: 3;
      justify-self: end;
      margin-right: var(--space-2);
    }
  }

  /* ---------- Desktop: one title rule across the grid; heading c1–4 anchored to the facts on c5–12 ---------- */
  @media (min-width: 1100px) {
    .certainty {
      --layer-gap: clamp(48px, 4.4vw, 64px);
      --facts-pt: 48px;
    }
    .head-rule {
      display: block;
      grid-column: 1 / -1;
      grid-row: 1;
      height: 2px;
      background: var(--graphite);
    }
    .intro {
      grid-column: 1 / 5;
      grid-row: 2;
      margin-bottom: 0;
      /* the heading's cap line sits level with the tops of the display figures */
      padding-top: calc(var(--facts-pt) + 6px);
    }
    .doc {
      grid-column: 5 / -1;
      grid-row: 2;
    }
    h2 {
      font-size: var(--fs-display-l);
      max-width: 7.8em; /* three lines: leaves a full gutter before the first figure */
    }
    .lead {
      max-width: 22rem;
    }
    .facts {
      border-top: 0;
    }
    .fact {
      padding: var(--facts-pt) var(--cell-pad) 56px;
    }
    .fact:first-child {
      padding-top: var(--facts-pt);
    }
    .fact:last-child {
      padding-bottom: 56px;
    }
    .figure.words {
      --wr: 0.5;
    }
    .terms .row {
      min-height: 76px;
    }
  }
</style>
