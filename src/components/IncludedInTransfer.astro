---
/*
  Included in every transfer: "the conditions of carriage".

  Light stone section after the graphite booking section. Service terms set as a
  ruled list (label | sentence, 1px hairlines), not cards. One photograph (I1)
  supports the business-transfer use case; it is evidence, not the content.

  Desktop (≥1100px): I1 in c1–5, heading + list in c7–12. The photograph is
  `position: sticky` (CSS only) and ends with the section.
  Tablet (2:1 band) / mobile (3:2 band): heading, lead, photograph, then the list. No sticky.

  Only `confirmed` items render (see `included.items` in data/ui.ts).
*/
import { Picture } from 'astro:assets';
import businessImage from '../assets/images/included-business-transfer.png';
import type { Lang } from '../data/ui';
import { getUi } from '../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
const inc = t.included;
const items = inc.items.filter((item) => item.status === 'confirmed');
---

<section class="included" aria-labelledby="included-title">
  <div class="page-grid">
    <div class="intro">
      <h2 id="included-title">{inc.title}</h2>
      <p class="lead">{inc.lead}</p>
    </div>

    <div class="media">
      <figure class="photo">
        <!-- I1: illustrative business / premium transfer photograph. Crop is set by --i1-position.
             Lazy: it sits well below the fold and must not compete with the H1 photograph. The frame has a fixed
             aspect ratio, so nothing shifts when it arrives. (A full-page capture has to scroll the page first.) -->
        <Picture
          src={businessImage}
          alt={inc.imageAlt}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          quality={72}
          widths={[480, 720, 1000]}
          sizes="(min-width: 1100px) 36vw, (min-width: 768px) calc(100vw - 64px), calc(100vw - 40px)"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <dl class="terms">
      {
        items.map((item) => (
          <div class="term">
            <dt>{item.label}</dt>
            <dd>{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .included {
    /* Crop of I1: x y. Phone shows a 3:2 band, tablet a 2:1 band, desktop the 4:5 portrait. */
    --i1-position: 50% 66%;
    background: var(--stone);
    color: var(--graphite);
    /* Top padding is shorter than the bottom: the dark section above already carries its own space. */
    padding-top: clamp(72px, 7.2vw, 104px);
    padding-bottom: clamp(72px, 8.4vw, 120px);
  }

  /* ---------- Intro ---------- */
  .intro {
    grid-column: 1 / -1;
  }
  h2 {
    font-size: var(--fs-display-l);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
  }
  .lead {
    max-width: 30rem;
    margin-top: var(--space-2);
    text-wrap: balance;
    color: var(--graphite-2);
    font-size: var(--fs-body-l);
    line-height: 1.45;
  }

  /* ---------- Photograph ---------- */
  .media {
    grid-column: 1 / -1;
    margin-top: var(--space-5);
  }
  .photo {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--stone-2); /* holds the space while the image loads */
  }
  .photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--i1-position);
  }

  /* ---------- Conditions list ---------- */
  .terms {
    grid-column: 1 / -1;
    margin-top: var(--space-5);
    border-bottom: 1px solid var(--hairline);
  }
  .term {
    padding-block: 15px;
    border-top: 1px solid var(--hairline);
  }
  dt {
    color: var(--graphite-2);
    font-size: var(--fs-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    line-height: 1.2;
  }
  dd {
    margin: 6px 0 0;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* ---------- Tablet: stacked, label beside sentence ---------- */
  @media (min-width: 768px) {
    h2 {
      font-size: clamp(2.25rem, 3.8vw, 3rem);
    }
    .media {
      margin-top: var(--space-6);
    }
    /* A wider, shorter band than the phone's 3:2: at tablet widths 3:2 would make the photograph taller than the list. */
    .photo {
      aspect-ratio: 2 / 1;
    }
    .terms {
      margin-top: var(--space-6);
    }
    .term {
      display: grid;
      grid-template-columns: 12rem minmax(0, 1fr);
      column-gap: var(--space-3);
      align-items: baseline;
      padding-block: 22px;
    }
    dd {
      margin: 0;
      font-size: var(--fs-body-l);
      line-height: 1.45;
    }
  }

  /* ---------- Desktop: photograph c1–5 beside heading + list c7–12 ---------- */
  @media (min-width: 1100px) {
    .intro {
      grid-column: 7 / 13;
      grid-row: 1;
    }
    .media {
      grid-column: 1 / 6;
      grid-row: 1 / 3; /* stretches over intro + list so the sticky photo has room to travel */
      margin-top: 0;
    }
    .photo {
      aspect-ratio: 4 / 5;
      position: sticky;
      top: 96px;
    }
    .terms {
      grid-column: 7 / 13;
      grid-row: 2;
      margin-top: var(--space-6);
    }
    .term {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
    dd {
      max-width: none;
    }
  }
</style>
