---
/*
  Legal page: Privacy Policy and Terms & Conditions share this one template. Content is data/legal.ts (+ .lt.ts).

  Plain typography, no cards and no icons. The same quiet structure as the service pages: a 2px rule, the H1, a
  short lead and the "Last updated" date, then ruled sections with the heading in the left rail (c1–4) and the
  text in a readable column (c5–12 on desktop). Stacked on phone and tablet.

  Inline links in the data are written [label](href). A leading "/" is a language-relative page path.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLegalPage, legalUpdated, type LegalSlug } from '../data/legal';
import type { Lang } from '../data/ui';
import { languages } from '../data/ui';
import { localePath } from '../utils/i18n';

interface Props {
  lang: Lang;
  slug: LegalSlug;
}

const { lang, slug } = Astro.props;
const page = getLegalPage(lang, slug);
const updated = new Intl.DateTimeFormat(languages[lang].htmlLang === 'lt' ? 'lt-LT' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(`${legalUpdated}T00:00:00Z`));

type Part = { text: string; href?: string };

/** Split "text [label](href) text" into plain and linked parts. */
function parts(source: string): Part[] {
  const out: Part[] = [];
  const re = /\[([^\]]+)\]\(([^)]+)\)/g;
  let last = 0;
  for (const m of source.matchAll(re)) {
    if (m.index! > last) out.push({ text: source.slice(last, m.index) });
    const href = m[2].startsWith('/') ? localePath(lang, m[2]) : m[2];
    out.push({ text: m[1], href });
    last = m.index! + m[0].length;
  }
  if (last < source.length) out.push({ text: source.slice(last) });
  return out;
}
---

<BaseLayout lang={lang} title={page.metaTitle} description={page.metaDescription}>
  <article class="legal">
    <header class="mast">
      <div class="page-grid">
        <div class="eyebrow" aria-hidden="true"></div>
        <h1 class="h1">{page.h1}</h1>
        <div class="intro">
          <p class="lead">{page.lead}</p>
          <p class="updated">{page.updatedLabel}: <time datetime={legalUpdated}>{updated}</time></p>
        </div>
      </div>
    </header>

    {
      page.sections.map((section) => (
        <section class="sec" aria-labelledby={section.id}>
          <div class="page-grid">
            <div class="rule" aria-hidden="true" />
            <h2 class="rail" id={section.id}>{section.heading}</h2>
            <div class="body">
              {section.blocks.map((block) => {
                if (block.type === 'p') {
                  return (
                    <p>
                      {parts(block.text).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}
                    </p>
                  );
                }
                const items = block.items.map((item) => (
                  <li>{parts(item).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}</li>
                ));
                return block.type === 'ol' ? <ol class="list">{items}</ol> : <ul class="list">{items}</ul>;
              })}
            </div>
          </div>
        </section>
      ))
    }
  </article>
</BaseLayout>

<style>
  .legal {
    --h1: clamp(2.25rem, 9.6vw, 2.5rem);
    padding-bottom: var(--space-5);
  }

  /* ---------- Masthead ---------- */
  .mast {
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
  }
  .eyebrow {
    grid-column: 1 / -1;
    height: 2px;
    background: var(--graphite);
  }
  .h1 {
    grid-column: 1 / -1;
    margin-top: var(--space-4);
    font-size: var(--h1);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    text-wrap: balance;
  }
  .intro {
    grid-column: 1 / -1;
    margin-top: var(--space-3);
    max-width: 38rem;
  }
  .lead {
    font-size: var(--fs-body-l);
    line-height: 1.4;
    text-wrap: pretty;
  }
  .updated {
    margin-top: 12px;
    color: var(--graphite-2);
    font-size: var(--fs-small);
  }

  /* ---------- Sections: hairline, rail heading, readable body ---------- */
  .rule {
    grid-column: 1 / -1;
    height: 1px;
    background: var(--hairline);
  }
  .rail {
    grid-column: 1 / -1;
    padding-top: 22px;
    font-size: var(--fs-title);
    line-height: 1.2;
    letter-spacing: -0.01em;
    scroll-margin-top: calc(var(--header-h) + 8px);
  }
  .body {
    grid-column: 1 / -1;
    min-width: 0;
    max-width: 38rem;
    padding-top: var(--space-2);
    padding-bottom: var(--space-4);
  }
  .body p {
    text-wrap: pretty;
  }
  .body p + p,
  .body p + .list,
  .body .list + p {
    margin-top: 14px;
  }
  .list {
    margin: 0;
    padding-left: 1.25rem;
  }
  ul.list {
    list-style: disc;
  }
  ol.list {
    list-style: decimal;
  }
  .list li {
    padding-left: 4px;
    text-wrap: pretty;
  }
  .list li + li {
    margin-top: 6px;
  }
  .body a {
    color: var(--graphite);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  @media (min-width: 768px) {
    .legal {
      --h1: clamp(2.75rem, 4.4vw, 4rem);
    }
    .mast {
      padding-top: var(--space-5);
      padding-bottom: var(--space-6);
    }
    .h1 {
      margin-top: var(--space-5);
    }
    .intro {
      margin-top: var(--space-4);
    }
    .rail {
      padding-top: 28px;
    }
    .body {
      padding-top: var(--space-3);
      padding-bottom: var(--space-5);
    }
  }

  @media (min-width: 1100px) {
    .mast {
      padding-bottom: 72px;
    }
    .intro {
      grid-column: 5 / 12;
    }
    .rule {
      grid-row: 1;
    }
    .rail {
      grid-column: 1 / 5;
      grid-row: 2;
      padding-top: 32px;
    }
    .body {
      grid-column: 5 / -1;
      grid-row: 2;
      padding-top: 32px;
      padding-bottom: 48px;
    }
  }
</style>
