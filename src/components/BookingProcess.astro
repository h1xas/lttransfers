---
/*
  How booking works: "the line and the confirmation".

  The first graphite section. A vertical route line with four stations on the
  left; one example confirmation, the only framed object, on the right.
  Mobile reading order: intro, stations 1–2, confirmation, stations 3–4, link.

  The two station lists are one process (the second `<ol>` starts at 3). Below
  900px the confirmation sits between them; from 900px a grid puts it beside them.

  Progressive enhancement: from 900px, without reduced motion, the active station
  fills its marker and lifts the confirmation rows it produces. Without that
  (mobile, reduced motion, no JS) every marker is filled and every row is at full
  opacity, with a small station number on each row instead.
*/
import ArrowIcon from './ArrowIcon.astro';
import type { Lang } from '../data/ui';
import { getUi, localePath } from '../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUi(lang);
const b = t.booking;
const d = b.doc;

const stations = [
  { n: 1, ...b.steps.request },
  { n: 2, ...b.steps.price },
  { n: 3, ...b.steps.confirmed },
  { n: 4, ...b.steps.travel },
];
const firstHalf = stations.slice(0, 2);
const secondHalf = stations.slice(2);
---

<section class="booking" id="how-it-works" aria-labelledby="booking-title" data-booking>
  <div class="page-grid">
    <div class="intro">
      <h2 id="booking-title">{b.title}</h2>
      <p class="lead">{b.lead}</p>
    </div>

    <ol class="steps steps-first" role="list">
      {
        firstHalf.map((s) => (
          <li class="station" data-station>
            <h3 class="station-title">
              <span class="marker" data-marker aria-hidden="true" />
              <span class="num">{s.n}</span>
              <span class="name">{s.title}</span>
            </h3>
            <p class="station-text">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <figure class="doc-wrap">
      <div class="doc">
        <div class="doc-head">
          <span class="doc-label">{d.label}</span>
          <span class="ref" aria-label={d.referenceNote}>LT-<span class="blank" aria-hidden="true"></span></span>
        </div>

        <dl class="rows">
          <div class="row" data-steps="1">
            <dt>{d.route}</dt>
            <dd class="route">
              {d.example.from}
              <ArrowIcon class="route-arrow" width={22} />
              <span class="sr-only"> {t.routes.to} </span>
              {d.example.to} <span class="code">{d.example.toCode}</span>
            </dd>
            <span class="tag" aria-hidden="true">1</span>
          </div>
          <div class="row" data-steps="3 4">
            <dt>{d.pickup}</dt>
            <dd>{d.example.date}, <span class="time">{d.example.time}</span></dd>
            <span class="tag" aria-hidden="true">3</span>
          </div>
          <div class="row" data-steps="3">
            <dt>{d.pickupLocation}</dt>
            <dd class="muted">{d.placeholderAddress}</dd>
            <span class="tag" aria-hidden="true">3</span>
          </div>
          <div class="row" data-steps="1">
            <dt>{d.flight}</dt>
            <dd>BT <span class="blank" aria-hidden="true"></span><span class="sr-only">{d.placeholderBlank}</span> <span class="note">{d.flightNote}</span></dd>
            <span class="tag" aria-hidden="true">1</span>
          </div>

          <div class="row group" data-steps="2 4">
            <dt>{d.vehicle}</dt>
            <dd>{d.example.vehicle}</dd>
            <span class="tag" aria-hidden="true">2</span>
          </div>
          <div class="row" data-steps="4">
            <dt>{d.colour}</dt>
            <dd class="muted">{d.placeholderColour}</dd>
            <span class="tag" aria-hidden="true">4</span>
          </div>
          <div class="row" data-steps="4">
            <dt>{d.plate}</dt>
            <dd class="muted">{d.placeholderPlate}</dd>
            <span class="tag" aria-hidden="true">4</span>
          </div>

          <div class="row group" data-steps="3">
            <dt>{d.contact}</dt>
            <dd>+370 …</dd>
            <span class="tag" aria-hidden="true">3</span>
          </div>
          <div class="row" data-steps="3">
            <dt>{d.payment}</dt>
            <dd>{d.paymentValue}</dd>
            <span class="tag" aria-hidden="true">3</span>
          </div>

          <div class="row price" data-steps="2">
            <dt>{d.price}</dt>
            <dd>€ <span class="blank" aria-hidden="true"></span><span class="sr-only">{d.placeholderBlank}</span></dd>
            <span class="tag" aria-hidden="true">2</span>
          </div>
        </dl>
      </div>
      <figcaption>{d.caption}</figcaption>
    </figure>

    <ol class="steps steps-second" role="list" start="3">
      {
        secondHalf.map((s) => (
          <li class="station" data-station>
            <h3 class="station-title">
              <span class="marker" data-marker aria-hidden="true" />
              <span class="num">{s.n}</span>
              <span class="name">{s.title}</span>
            </h3>
            <p class="station-text">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <p class="more">
      <a class="more-link" href={localePath(lang, b.linkPath)}>
        <span>{b.link}</span>
        <ArrowIcon class="more-arrow" width={22} />
      </a>
    </p>
  </div>
</section>

<style>
  .booking {
    /* Local aliases; every value resolves to a central token. */
    --ring: 12px;
    --line: 1.5px;
    --rail: 40px; /* marker column */
    --station-fs: var(--fs-route);
    --station-lh: 1.3;
    /* distance from a station's top to the marker's top, so the ring centres on the title's first line */
    --ring-top: calc((var(--station-fs) * var(--station-lh) - var(--ring)) / 2);
    --gap: 40px; /* space below a station */

    background: var(--graphite);
    color: var(--bone);
    /* Trimmed from 160: the section is already tall, and the stone either side supplies air. */
    padding-block: clamp(64px, 8.9vw, 128px);
  }

  /* The global focus ring is pine, which disappears on graphite. */
  .booking :focus-visible {
    outline-color: var(--pine-light);
  }
  .booking ::selection {
    background: var(--pine-light);
    color: var(--graphite);
  }

  /* ---------- Intro ---------- */
  .intro {
    grid-column: 1 / -1;
    margin-bottom: var(--space-5);
  }
  h2 {
    font-size: var(--fs-display-l);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    color: var(--bone);
  }
  .lead {
    max-width: 30rem;
    margin-top: var(--space-2);
    text-wrap: balance;
    color: var(--ash);
    font-size: var(--fs-body-l);
    line-height: 1.45;
  }

  /* ---------- Route line and stations ---------- */
  .steps {
    grid-column: 1 / -1;
    max-width: 34rem;
    padding: 0;
    list-style: none;
  }
  .station {
    list-style: none;
  }
  .station {
    position: relative;
    padding-left: var(--rail);
    padding-bottom: var(--gap);
  }
  /* The line: runs from this station's marker down into the next station's marker. */
  .station::before {
    content: '';
    position: absolute;
    left: calc((var(--ring) - var(--line)) / 2);
    top: calc(var(--ring-top) + var(--ring) / 2);
    bottom: calc(var(--ring-top) * -1 - var(--ring) / 2);
    width: var(--line);
    background: var(--pine-light);
    transition: background-color var(--dur-route) var(--ease);
  }
  .steps-second .station:last-child {
    padding-bottom: 0;
  }
  .steps-second .station:last-child::before {
    display: none;
  }

  .station-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: var(--station-fs);
    line-height: var(--station-lh);
    font-weight: var(--weight-medium);
    letter-spacing: var(--track-upper);
    text-transform: uppercase;
    text-wrap: pretty;
    color: var(--bone);
  }
  .marker {
    position: absolute;
    left: 0;
    top: var(--ring-top);
    width: var(--ring);
    height: var(--ring);
    box-sizing: border-box;
    border: var(--line) solid var(--pine-light);
    border-radius: 50%;
    background: var(--pine-light); /* static state: every station is "reached" */
    transition: background-color var(--dur-route) var(--ease);
  }
  .num {
    min-width: 0.75em;
    color: var(--ash);
    font-variant-numeric: tabular-nums;
  }
  .station-text {
    max-width: 29rem;
    margin-top: 8px;
    color: var(--ash);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    transition: color var(--dur-route) var(--ease);
  }

  /* ---------- Confirmation ---------- */
  .doc-wrap {
    grid-column: 1 / -1;
    max-width: 34rem;
    /* On mobile the line passes behind the document: it runs into the top edge and resumes from the bottom. */
    margin-block: 0;
    container-type: inline-size;
  }
  .doc {
    background: var(--paper);
    color: var(--graphite);
    border-radius: var(--radius-doc);
    overflow: hidden;
  }
  .doc-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 16px var(--object-inset);
    border-bottom: 1px solid var(--hairline);
  }
  .doc-label {
    font-size: var(--fs-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    line-height: 1.2;
  }
  .ref {
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    color: var(--graphite-2);
    white-space: nowrap;
  }

  .blank {
    display: inline-block;
    width: 2.25ch;
    height: 1em;
    vertical-align: -0.1em;
    border-bottom: 1.5px solid currentColor;
  }

  .rows {
    padding-inline: var(--object-inset);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'dt tag'
      'dd dd';
    column-gap: var(--space-1);
    row-gap: 2px;
    align-items: baseline;
    padding-block: 12px;
    border-top: 1px solid var(--hairline);
    transition: opacity var(--dur-route) var(--ease);
  }
  .row:first-child,
  .row.price {
    border-top: 0;
  }
  .row dt {
    grid-area: dt;
    color: var(--graphite-2);
    font-size: var(--fs-small);
    line-height: 1.3;
  }
  .row dd {
    grid-area: dd;
    margin: 0;
    font-size: 1.0625rem;
    font-weight: var(--weight-medium);
    line-height: 1.35;
    transition: opacity var(--dur-route) var(--ease);
  }
  .muted {
    color: var(--graphite-2);
    font-weight: var(--weight-regular);
  }
  .note {
    margin-left: 4px;
    color: var(--graphite-2);
    font-size: var(--fs-small);
    font-weight: var(--weight-regular);
  }
  .time {
    font-variant-numeric: tabular-nums;
  }

  .route {
    letter-spacing: var(--track-upper);
    text-transform: uppercase;
  }
  .route :global(.route-arrow) {
    display: inline-block;
    width: 22px;
    height: 11px;
    margin-inline: 6px;
    vertical-align: middle;
    color: var(--pine);
  }
  .route .code {
    margin-left: 0.2em;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: var(--weight-regular);
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--graphite-2);
  }

  /* Station number on each row: the static stand-in for the live highlight. */
  .tag {
    grid-area: tag;
    color: var(--graphite-2);
    font-size: var(--fs-label);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  /* The agreed price: strongest row, on the timetable's 2px rule. */
  .row.price {
    grid-template-columns: auto auto 1fr;
    grid-template-areas: 'dt tag dd';
    margin-top: 4px;
    padding-block: 20px 22px;
    border-top: 2px solid var(--graphite);
  }
  .row.price dt {
    color: var(--graphite);
    font-size: var(--fs-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }
  .row.price dd {
    justify-self: end;
    font-size: 2.25rem;
    line-height: 1;
    letter-spacing: var(--track-display);
    font-variant-numeric: tabular-nums;
  }
  .row.price .blank {
    width: 2.6ch;
  }

  /* label beside value once the document is wide enough */
  @container (min-width: 24rem) {
    .row:not(.price) {
      grid-template-columns: 8.25rem 1fr auto;
      grid-template-areas: 'dt dd tag';
    }
  }

  figcaption {
    max-width: 26rem;
    margin-top: var(--space-2);
    color: var(--ash);
    font-size: var(--fs-small);
    line-height: 1.5;
  }

  /* ---------- Link ---------- */
  .more {
    grid-column: 1 / -1;
    margin-top: var(--space-5);
  }
  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: var(--tap);
    padding-bottom: 2px;
    color: var(--bone);
    font-size: var(--fs-body-l);
    font-weight: var(--weight-medium);
    text-decoration: none;
    border-bottom: 1px solid var(--hairline-dark);
    transition: border-color var(--dur-fast) var(--ease);
  }
  .more-link :global(.more-arrow) {
    color: var(--pine-light);
    transition: transform var(--dur-fast) var(--ease);
  }
  .more-link:hover {
    border-bottom-color: var(--pine-light);
  }
  .more-link:hover :global(.more-arrow) {
    transform: translateX(4px);
  }

  /* ---------- Single column: the line passes behind the document ---------- */
  @media (max-width: 899px) {
    .steps-first .station:last-child {
      padding-bottom: var(--gap);
    }
    /* stop exactly at the document's top edge */
    .steps-first .station:last-child::before {
      bottom: 0;
    }
    .doc-wrap {
      margin-bottom: var(--space-2);
    }
    /* the line resumes below the document and runs down to station 3 */
    .steps-second {
      position: relative;
      padding-top: var(--gap);
    }
    .steps-second::before {
      content: '';
      position: absolute;
      left: calc((var(--ring) - var(--line)) / 2);
      top: 0;
      height: calc(var(--gap) + var(--ring-top) + var(--ring) / 2);
      width: var(--line);
      background: var(--pine-light);
    }
  }

  /* ---------- Two columns ---------- */
  @media (min-width: 900px) {
    .intro,
    .steps {
      grid-column: 1 / 5;
    }
    .intro {
      grid-row: 1;
      margin-bottom: 64px;
    }
    .steps-first {
      grid-row: 2;
    }
    .steps-second {
      grid-row: 3;
      padding-top: 0;
    }
    .steps-second::before {
      display: none;
    }
    .doc-wrap {
      grid-column: 5 / 9;
      grid-row: 1 / 4;
      align-self: start;
      margin-left: var(--space-3);
    }
    .more {
      grid-column: 5 / 9;
      grid-row: 4;
      margin-left: var(--space-3);
      margin-top: var(--space-5);
    }
    h2 {
      font-size: clamp(2.25rem, 3.8vw, 3rem);
    }
    .booking {
      --gap: clamp(40px, 4.4vw, 64px);
    }
  }
  @media (min-width: 1100px) {
    .intro,
    .steps {
      grid-column: 1 / 6;
    }
    .doc-wrap {
      grid-column: 7 / 12;
      margin-left: 0;
    }
    .more {
      grid-column: 7 / 12;
      margin-left: 0;
    }
  }

  /* ---------- Live state (set by the script; only from 900px without reduced motion) ---------- */
  .booking.is-live .marker {
    background: transparent;
  }
  .booking.is-live .station::before {
    background: var(--hairline-dark);
  }
  .booking.is-live [data-state='done'] .marker,
  .booking.is-live [data-state='active'] .marker {
    background: var(--pine-light);
  }
  .booking.is-live [data-state='done']::before {
    background: var(--pine-light);
  }
  /* the current station: a second ring, set off from the line by a graphite gap */
  .booking.is-live [data-state='active'] .marker {
    box-shadow:
      0 0 0 3px var(--graphite),
      0 0 0 4.5px var(--pine-light);
  }
  .booking.is-live [data-state='active'] .station-text {
    color: var(--bone);
  }
  .booking.is-live .tag {
    display: none;
  }
  .booking.is-live .row:not([data-active]) dd {
    opacity: 0.66;
  }
  .booking.is-live .row::before {
    content: '';
    position: absolute;
    left: calc(var(--object-inset) * -1);
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: var(--pine);
    opacity: 0;
    transition: opacity var(--dur-route) var(--ease);
  }
  .booking.is-live .row[data-active]::before {
    opacity: 1;
  }
  .booking.is-live .row.price::before {
    top: 12px;
    bottom: 12px;
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('[data-booking]');

  if (section) {
    const stations = [...section.querySelectorAll<HTMLElement>('[data-station]')];
    const rows = [...section.querySelectorAll<HTMLElement>('[data-steps]')];
    const markers = stations.map((s) => s.querySelector<HTMLElement>('[data-marker]') ?? s);
    const live = window.matchMedia('(min-width: 900px) and (prefers-reduced-motion: no-preference)');

    let current = -1;
    let ticking = false;

    const apply = (index: number) => {
      if (index === current) return;
      current = index;
      stations.forEach((s, i) => {
        s.dataset.state = i < index ? 'done' : i === index ? 'active' : 'upcoming';
      });
      const n = String(index + 1);
      rows.forEach((row) => {
        row.toggleAttribute('data-active', (row.dataset.steps ?? '').split(' ').includes(n));
      });
    };

    const update = () => {
      ticking = false;
      const line = window.innerHeight * 0.55;
      const atEnd = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
      let index = 0;
      markers.forEach((m, i) => {
        const r = m.getBoundingClientRect();
        if (r.top + r.height / 2 <= line) index = i;
      });
      apply(atEnd ? stations.length - 1 : index);
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    const sync = () => {
      if (live.matches) {
        section.classList.add('is-live');
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        current = -1;
        update();
      } else {
        section.classList.remove('is-live');
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
        current = -1;
        stations.forEach((s) => delete s.dataset.state);
        rows.forEach((r) => r.removeAttribute('data-active'));
      }
    };

    live.addEventListener('change', sync);
    sync();
  }
</script>
